# Copy to infra/.env.prod and fill in real values. Never commit the filled-in
# version — it holds real secrets. Mirrors the systemd deployment's
# /etc/plateforme/backend.env, adjusted for the container (storage path is
# the volume mounted in docker-compose.prod.yml, not a host path).

DB_URL=jdbc:postgresql://10.185.22.72:5432/plateforme
DB_USERNAME=plateforme
DB_PASSWORD=

APP_JWT_SECRET=
CORS_ORIGINS=https://evenements-19.mtdpce-test.gov.bf
FRONTEND_BASE_URL=https://evenements-19.mtdpce-test.gov.bf
APP_CALLBACK_BASE_URL=https://evenements-19.mtdpce-test.gov.bf

STORAGE_LOCAL_PATH=/app/storage
STORAGE_LOCAL_URL=https://evenements-19.mtdpce-test.gov.bf/files

PAYMENT_PROVIDER=sandbox
PAYMENT_WEBHOOK_SECRET=

DEMO_DATA=false
SUPER_ADMIN_PASSWORD=

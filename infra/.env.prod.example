# À copier en infra/.env.prod puis à remplir. Ne JAMAIS commiter le fichier
# rempli : il contient de vrais secrets. Voir README-HEBERGEMENT.md.

# ── Domaine public (à adapter) ─────────────────────────────────────────────
CORS_ORIGINS=https://evenements-19.mtdpce-test.gov.bf
FRONTEND_BASE_URL=https://evenements-19.mtdpce-test.gov.bf
APP_CALLBACK_BASE_URL=https://evenements-19.mtdpce-test.gov.bf
STORAGE_LOCAL_URL=https://evenements-19.mtdpce-test.gov.bf/files

# ── Base de données ────────────────────────────────────────────────────────
# Avec --profile db (PostgreSQL dans Docker) : laisser DB_URL tel quel.
# Base externe : mettre son adresse, ex. jdbc:postgresql://10.185.22.72:5432/plateforme
DB_URL=jdbc:postgresql://postgres:5432/plateforme
DB_USERNAME=plateforme
DB_PASSWORD=

# ── Secrets applicatifs ────────────────────────────────────────────────────
# Chacun se génère avec :  openssl rand -base64 32
APP_JWT_SECRET=
PAYMENT_WEBHOOK_SECRET=

# Compte super admin créé au premier démarrage.
SUPER_ADMIN_EMAIL=admin@plateforme.bf
SUPER_ADMIN_PASSWORD=

# ── Paiement ───────────────────────────────────────────────────────────────
# sandbox = paiement simulé (aucun vrai argent). Pour FasoArzeka : arzeka + le
# bloc FASOARZEKA_* (voir backend/.env.example).
PAYMENT_PROVIDER=sandbox

# ── E-mail ─────────────────────────────────────────────────────────────────
# Serveur SMTP SANS authentification (relais interne). Tant que MAIL_HOST reste
# "localhost", aucun e-mail n'est envoyé (mot de passe oublié, etc.) mais le
# reste fonctionne.
MAIL_HOST=localhost
MAIL_PORT=1025

# ── Stockage des fichiers (dans le conteneur : ne pas changer) ─────────────
STORAGE_LOCAL_PATH=/app/storage

DEMO_DATA=false

# ── Options de déploiement (lues par docker compose) ───────────────────────
# Où sont stockés les fichiers téléversés sur le serveur hôte :
# STORAGE_HOST_PATH=/opt/plateforme/storage
# Ports publiés (80/443 par défaut) :
# HTTP_PORT=80
# HTTPS_PORT=443
# HTTPS géré par le conteneur (mode 2 du README) :
# NGINX_CONF=../frontend/nginx.tls.conf
# CERTS_DIR=./certs

# Copier vers .env et adapter. Utilise par docker-compose et le backend.

# --- Base de donnees ---
# Le conteneur Docker expose PostgreSQL sur le port hote 5433 (evite un conflit
# avec un PostgreSQL installe localement). Changer DB_PORT pour l'ajuster.
DB_PORT=5433
DB_URL=jdbc:postgresql://localhost:5433/plateforme
DB_USERNAME=plateforme
DB_PASSWORD=plateforme

# --- Serveur ---
SERVER_PORT=8080
# Motifs d'origine separes par des virgules (dev : tout port localhost).
# En production : domaine(s) reel(s), ex. https://plateforme.bf
CORS_ORIGINS=http://localhost:[*],http://127.0.0.1:[*]

# --- Securite JWT (production : generer un secret 256 bits base64) ---
# openssl rand -base64 32
APP_JWT_SECRET=Y2hhbmdlLW1lLXRoaXMtaXMtYS1kZXYtb25seS1zZWNyZXQtMzJieXRlcyE=

# --- Super administrateur initial ---
SUPER_ADMIN_EMAIL=admin@plateforme.bf
SUPER_ADMIN_PASSWORD=ChangeMe!2026

# --- Durcissement ---
RATE_LIMIT_PER_MINUTE=20   # limite login/register par IP (0 = desactive)

# --- Donnees de demonstration (SIAO, FESPACO, Semaine du Numerique 2027) ---
DEMO_DATA=false            # true pour peupler la base au demarrage
# organisateur de demo : organisateur@plateforme.bf / Demo!2026

# --- Email (Mailpit en dev) ---
MAIL_HOST=localhost
MAIL_PORT=1025

# --- Stockage fichiers ---
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./data/storage
STORAGE_LOCAL_URL=http://localhost:8080/files

# --- Paiement ---
# sandbox (defaut, paiement simule) ou arzeka (passerelle FasoArzeka reelle,
# ecrans web/mobile deja branches sur paymentUrl). APP_CALLBACK_BASE_URL doit
# etre joignable depuis les serveurs FasoArzeka (tunnel ngrok/... en local).
PAYMENT_PROVIDER=sandbox
PAYMENT_WEBHOOK_SECRET=dev-webhook-secret

# --- FasoArzeka (AvePLUS) - lu seulement si PAYMENT_PROVIDER=arzeka ---
# Test : https://pgw-test.fasoarzeka.bf . Ne JAMAIS commiter les vraies
# valeurs : mettre les identifiants reels dans .env (ignore par git), pas ici.
FASOARZEKA_BASE_URL=https://pgw-test.fasoarzeka.bf
FASOARZEKA_INITIATE_PAYMENT_URI=/AvepayPaymentGatewayUI/avepay-payment/app/validorder
FASOARZEKA_CHECK_ORDER_STATUS_URI=/AvepayPaymentGatewayUI/avepay-payment/app/getThirdPartyMapInfo
FASOARZEKA_AUTH_URI=/AvepayPaymentGatewayUI/avepay-payment/auth/getToken
FASOARZEKA_MERCHANT_ID=
FASOARZEKA_USERNAME=
FASOARZEKA_PASSWORD=
FASOARZEKA_GRANT_TYPE=access_token
# URL publique de CETTE application, que FasoArzeka doit pouvoir appeler
# (callback). En local avec leur bac a sable, il faut un tunnel (ngrok...) -
# localhost n'est pas joignable depuis leurs serveurs.
APP_CALLBACK_BASE_URL=http://localhost:8080
# Jeton statique de test fourni par leur doc (section 2.3) - depannage
# uniquement si /auth/getToken pose probleme en test ; laisser vide sinon,
# et ne jamais le renseigner en production.
FASOARZEKA_TEST_STATIC_TOKEN=
